{
  "name": "maccabis-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Dashboard de estadísticas del club de baloncesto Maccabis (web estática + scripts de generación de datos)",
  "scripts": {
    "diccionario": "node scripts/parse_diccionario.js",
    "historico": "node scripts/build_historico.js",
    "build:datos": "npm run diccionario && npm run historico && npm run estadisticas && npm run fichas && npm run completar:historia && npm run historia:en-curso && npm run personas && npm run datos:sync",
    "personas": "node scripts/build_personas.js",
    "historia:en-curso": "node scripts/historia_en_curso.js",
    "check:historia": "node scripts/historia_en_curso.js --check && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/test_historia_en_curso.js",
    "datos:sync": "node plataforma/scripts/sincronizar_equipacion.mjs",
    "calendario:exportar": "node plataforma/scripts/exportar_calendario.mjs",
    "check:copias": "node plataforma/scripts/sincronizar_equipacion.mjs --check",
    "check:personas": "node scripts/build_personas.js --check",
    "completar:historia": "node scripts/completar_historia.js",
    "fichas": "node scripts/consolidar_fichas.js",
    "build:rivales": "node scripts/build_rivales_web.js",
    "estadisticas": "node scripts/estadisticas/generar_temporada.js --build",
    "jornada": "node scripts/estadisticas/procesar_jornada.js 2026-27",
    "test:regresion": "node scripts/estadisticas/test_regresion_2025_26.js",
    "test:liga": "node scripts/estadisticas/test_liga.js",
    "test:privacidad": "node scripts/estadisticas/test_privacidad.js",
    "liga": "node scripts/estadisticas/liga.js 2026-27",
    "test:duplicados": "node scripts/estadisticas/test_duplicados.js",
    "check:datos": "node scripts/check_datos_publicados.js",
    "test:datos": "node scripts/test_check_datos.js",
    "hooks:instalar": "git config core.hooksPath .githooks",
    "pruebas:rapidas": "node plataforma/pruebas/infra/corredor.mjs rapidas",
    "pruebas:completas": "node plataforma/pruebas/infra/corredor.mjs completas",
    "pruebas:limpiar": "node plataforma/pruebas/infra/limpiar.mjs",
    "ci:estado": "node scripts/ci_estado.mjs"
  },
  "devDependencies": {
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  }
}

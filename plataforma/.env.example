# Copia este archivo como .env.local (que NO se sube a git) y rellena los valores.
# Donde encontrarlos: Supabase > tu proyecto > Project Settings.

# API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# API Keys > la "publishable" (o la "anon" si tu panel la llama asi). Es publica por diseno: la protege RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO para los scripts locales (migraciones y semilla). NUNCA en Vercel.
# Database > Connection string > "Session pooler" (URI), con tu contrasena de la base de datos.
SUPABASE_DB_URL=
